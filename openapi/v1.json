{
  "openapi": "3.0.3",
  "info": {
    "title": "FocalPrompt API",
    "version": "1.0.0",
    "description": "Version 1 JSON API for focus detection, reported-focus assessment, and ablation analysis. Authenticate to your own inference backend via server environment (AI_GATEWAY_API_KEY or provider keys). No product API keys or account sessions."
  },
  "servers": [
    { "url": "http://127.0.0.1:5001", "description": "Local toolkit" },
    { "url": "https://focalprompt.com", "description": "Hosted demo (live inference may be disabled)" }
  ],
  "paths": {
    "/api/v1": {
      "get": {
        "summary": "API v1 index",
        "responses": { "200": { "description": "Metadata and doc links" } }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "summary": "This specification (JSON)",
        "responses": { "200": { "description": "OpenAPI document" } }
      }
    },
    "/api/v1/detect-foci": {
      "post": {
        "summary": "Detect foci in a prompt",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["prompt"],
                "properties": {
                  "prompt": { "type": "string" },
                  "model": { "type": "string" },
                  "provider": { "type": "string" },
                  "backend": { "type": "string", "description": "vercel_gateway | direct | openai_compatible" },
                  "api_key": { "type": "string" },
                  "base_url": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Detected foci" } }
      }
    },
    "/api/v1/detect-dynamic-foci": {
      "post": {
        "summary": "Detect dynamic slots",
        "responses": { "200": { "description": "Dynamic foci" } }
      }
    },
    "/api/v1/assess": {
      "post": {
        "summary": "Experiment A — reported focus distribution",
        "description": "Behavioural self-report for one completion; not transformer attention.",
        "responses": { "200": { "description": "Focus scores" } }
      }
    },
    "/api/v1/generate-output": {
      "post": {
        "summary": "Generate a completion for a prompt",
        "responses": { "200": { "description": "Model output" } }
      }
    },
    "/api/v1/rewrite-prompt": {
      "post": {
        "summary": "Rewrite prompt toward an intended focus mix",
        "responses": { "200": { "description": "Rewritten prompt" } }
      }
    },
    "/api/v1/build-agent-prompt": {
      "post": {
        "summary": "Build an agent prompt from selected foci",
        "responses": { "200": { "description": "Agent prompt" } }
      }
    },
    "/api/v1/ablation-analysis": {
      "post": {
        "summary": "Experiment B — leave-one-focus-out perturbation analysis",
        "responses": { "200": { "description": "Permutation + BH results" } }
      }
    }
  }
}
